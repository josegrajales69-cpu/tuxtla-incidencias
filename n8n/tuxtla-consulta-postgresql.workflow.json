    {
      "id": "c67628e9-1e1f-41db-8a99-55994724ad72",
      "name": "Confirmar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        180
      ],
      "parameters": {
        "jsCode": "const r=$json.result??$json;if(!r.message_id)throw new Error('Telegram no confirmó');return [{json:{ok:true,mode:'delivered',messageId:r.message_id}}];"
      }
    },
    {
      "id": "fd39e1ea-ea64-43c2-8fba-58493bce63f6",
      "name": "Responder al receptor",
