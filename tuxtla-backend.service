[Unit]
Description=Tuxtla Incidencias Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=jose
WorkingDirectory=/home/jose/tuxtla-incidencias/backend
EnvironmentFile=/home/jose/tuxtla-incidencias/backend/.env
ExecStart=/usr/bin/node /home/jose/tuxtla-incidencias/backend/dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
